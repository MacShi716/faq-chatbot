# .env.example  (값 없는 견본 파일 — 실제 키는 절대 여기에 쓰지 않는다)
#
# Tier B(FAQ 에 없는 질문에 AI 가 직접 답하는 기능) 설정. 기본은 꺼짐(off).
# 이 앱은 .env 파일을 자동으로 읽지 않는다. 아래 이름으로
#   (a) PowerShell 에서 $env:이름="값" 으로 환경변수를 설정하거나
#   (b) .streamlit/secrets.toml 에  이름 = "값"  으로 적는다.
# 두 파일(.env, .streamlit/secrets.toml)과 logs/ 는 모두 .gitignore 로 제외돼 있다.

# 서버 스위치: on / true / 1 이면 '서버에서 AI 사용 가능'. 그 외(기본)는 꺼짐 → 기존 FAQ 전용 동작과 동일.
# 서버가 켜져 있어도 '🤖 AI 대화 켜기' 토글을 사용자가 직접 켜야 AI 가 답한다(세션마다 기본 꺼짐).
# 제공자 키가 하나도 없으면 토글은 비활성("서버에 설정되지 않았습니다")으로 보인다.
LLM_ENABLED=off

# 사용할 제공자: cloudflare(기본) 또는 groq. 나머지 하나는 키가 있으면 429/5xx/시간초과 때 폴백으로 쓴다.
LLM_PROVIDER=cloudflare

# Cloudflare Workers AI (기본 제공자)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# 기본(gemma-4, 생각 끔)은 호출당 약 5 뉴런으로 가장 싸고 빠르다. 더 풍부한 답이 필요하면 아래처럼 바꿀 수 있다(호출당 약 28 뉴런):
#   LLM_MODEL=@cf/openai/gpt-oss-120b
# Kimi·GLM-5.x·DeepSeek-V4 계열은 Workers Free 에서 쓸 수 없다(403). 프롬프트에는 오늘 날짜(Asia/Seoul)와 이 모델 ID 가 자동으로 들어간다.
LLM_MODEL=@cf/google/gemma-4-26b-a4b-it

# Groq (선택, 폴백)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# (선택) 세션당 1분 최대 AI 호출 수. 기본 2.
# LLM_RATE_PER_MIN=2
